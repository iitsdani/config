{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "databricks-italy": {
      "type": "remote",
      "url": "https://prima-databricks-italy.cloud.databricks.com/api/2.0/mcp/sql",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.local/share/opencode/databricks-it}"
      }
    },
    "databricks-uk": {
      "type": "remote",
      "url": "https://prima-databricks-uk.cloud.databricks.com/api/2.0/mcp/sql",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.local/share/opencode/databricks-uk}"
      }
    },
    "youtrack": {
      "type": "remote",
      "url": "https://prima-assicurazioni-spa.myjetbrains.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.local/share/opencode/youtrack}"
      },
      "enabled": true
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.eu/api/unstable/mcp-server/mcp"
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {file:~/.local/share/opencode/github-token}"
      }
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    }
  },
  "plugin": ["opencode-add-dir"]
}
